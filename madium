-- ============================================================
-- WALL CHECK
-- ============================================================
local RAY_PARAMS
local function ensureRayParams()
    if not RAY_PARAMS then
        RAY_PARAMS = RaycastParams.new()
        local ok, exc = pcall(function() return Enum.RaycastFilterType.Exclude end)
        RAY_PARAMS.FilterType = (ok and exc) or Enum.RaycastFilterType.Blacklist
    end
    return RAY_PARAMS
end

local function los(p)
    if not p then return false end
    local cam = CAM(); if not cam then return false end
    local now = os.clock()
    local c   = LOSC[p]
    if c and now - c.t < 0.08 then return c.v end
    local ok, r = pcall(function()
        local cp = cam.CFrame.Position
        local d  = p.Position - cp
        local m  = d.Magnitude
        if m < 1 then return nil end
        local pa = ensureRayParams()
        local fl = {}
        if ME.Character then fl[1] = ME.Character end
        pa.FilterDescendantsInstances = fl
        return WS:Raycast(cp, d.Unit * m, pa)
    end)
    local v = true
    if ok and r then
        local hc = r.Instance and r.Instance:FindFirstAncestorOfClass("Model")
        v = hc and hc:FindFirstChildOfClass("Humanoid") and true or false
    end
    LOSC[p] = {t=now, v=v}
    return v
end

-- ============================================================
-- [FIX-IG1] PROXIMITY HELPER
-- Returns distance from local player's root to another
-- player's root. Returns math.huge if either has no character.
-- ============================================================
local function distToPlayer(pl)
    local myChar = ME.Character
    if not myChar then return math.huge end
    local myRoot = fr(myChar)
    if not myRoot then return math.huge end
    local theirChar = pl.Character
    if not theirChar then return math.huge end
    local theirRoot = fr(theirChar)
    if not theirRoot then return math.huge end
    return (myRoot.Position - theirRoot.Position).Magnitude
end

