-- ============================================================
-- IGNORE PANEL REFRESH  [FIX-IG1][FIX-IG2][FIX-IG3][FIX-IG4]
-- ============================================================
local function refreshIgnorePanel()
    local container = GUI.igContainer
    if not container then return end

    -- Search filter
    local q = ""
    if GUI.igSearch and GUI.igSearch.Text then
        q = GUI.igSearch.Text:lower()
    end
    if q ~= ST.igQuery then ST.igQuery = q; ST.igScroll = 0 end

    -- Clear existing rows
    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    -- Build candidate list with live distances
    local list = {}
    local ignoredCount = 0
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= ME then
            if q == "" or pl.Name:lower():find(q, 1, true) then
                local dist = distToPlayer(pl)  -- [FIX-IG1]
                list[#list+1] = {pl=pl, dist=dist}
            end
            if isIgnored(pl) then ignoredCount = ignoredCount + 1 end
        end
    end

    -- [FIX-IG2] Sort: proximity (nearest first) OR alphabetical
    if ST.igSortNear then
        -- Near-first: unknown distance (math.huge) falls to bottom
        -- Among same-distance players (both have no char), sort by name
        table.sort(list, function(a, b)
            if a.dist == b.dist then return a.pl.Name < b.pl.Name end
            return a.dist < b.dist
        end)
    else
        table.sort(list, function(a, b) return a.pl.Name < b.pl.Name end)
    end

    -- Update header status label: "12 players  |  3 ignored"
    if GUI.igStatusLbl then
        local total = #list
        GUI.igStatusLbl.Text = total .. " players  |  " .. ignoredCount .. " ignored"
    end

    -- Update sort button label to reflect current mode
    if GUI.igSortBtn then
        GUI.igSortBtn.Text = ST.igSortNear and "NEAR  ▲" or "A - Z  ▲"
    end

    if #list == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1,0,0,40)
        empty.Position = UDim2.new(0,0,0,10)
        empty.BackgroundTransparency = 1
        empty.Text = q ~= "" and "No players match" or "No players in server"
        empty.TextColor3 = Color3.fromRGB(180,180,180)
        empty.TextSize = 13; empty.Font = Enum.Font.Gotham
        empty.Parent = container
        return
    end

    local ROW     = 32   -- [IMPROVE] taller rows
    local contH   = math.max(60,
        container.AbsoluteSize.Y > 0
        and container.AbsoluteSize.Y
        or container.Size.Y.Offset)
    local VISIBLE = math.max(1, math.floor((contH - 8) / ROW))
    local MAX     = math.max(0, #list - VISIBLE)
    ST.igScroll   = cl(ST.igScroll or 0, 0, MAX)

    local y = 4
    for i = 1 + ST.igScroll, math.min(#list, ST.igScroll + VISIBLE) do
        local entry   = list[i]
        local pl      = entry.pl
        local dist    = entry.dist
        local ignored = isIgnored(pl)
        local cap     = pl  -- closure capture

        -- Row background
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1,0,0,ROW-2)
        row.Position = UDim2.new(0,0,0,y)
        row.BackgroundColor3 = ignored
            and Color3.fromRGB(110,25,25)
            or  Color3.fromRGB(32,32,52)
        row.BackgroundTransparency = 0.08
        row.BorderSizePixel = 0
        row.Parent = container
        pcall(function()
            Instance.new("UICorner", row).CornerRadius = UDim.new(0,5)
        end)

        -- Toggle button (click anywhere on the row)
        local clickBtn = Instance.new("TextButton")
        clickBtn.Size = UDim2.new(1,0,1,0)
        clickBtn.BackgroundTransparency = 1
        clickBtn.Text = ""
        clickBtn.ZIndex = 3
        clickBtn.Parent = row

        -- Status icon  [X] or [ ]
        local iconLbl = Instance.new("TextLabel")
        iconLbl.Size = UDim2.new(0,22,1,0)
        iconLbl.Position = UDim2.new(0,4,0,0)
        iconLbl.BackgroundTransparency = 1
        iconLbl.Text = ignored and "[X]" or "[ ]"
        iconLbl.TextColor3 = ignored
            and Color3.fromRGB(255,90,90)
            or  Color3.fromRGB(120,120,160)
        iconLbl.TextSize = 11
        iconLbl.Font = Enum.Font.GothamBold
        iconLbl.ZIndex = 2
        iconLbl.Parent = row

        -- Player name
        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size = UDim2.new(1,-90,1,0)
        nameLbl.Position = UDim2.new(0,28,0,0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = pl.Name
        nameLbl.TextColor3 = ignored
            and Color3.fromRGB(255,110,110)
            or  Color3.fromRGB(210,210,230)
        nameLbl.TextSize = 12
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
        nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
        nameLbl.ZIndex = 2
        nameLbl.Parent = row

        -- [FIX-IG3] Distance badge on the right
        local distLbl = Instance.new("TextLabel")
        distLbl.Size = UDim2.new(0,56,1,0)
        distLbl.Position = UDim2.new(1,-58,0,0)
        distLbl.BackgroundTransparency = 1
        local distStr
        if dist == math.huge then
            distStr = "? m"
        elseif dist >= 1000 then
            distStr = math.floor(dist/100)/10 .. "km"
        else
            distStr = math.floor(dist+0.5) .. " m"
        end
        distLbl.Text = distStr
        -- Color: green<50m, yellow<150m, red further, gray=unknown
        if dist == math.huge then
            distLbl.TextColor3 = Color3.fromRGB(100,100,120)
        elseif dist < 50 then
            distLbl.TextColor3 = Color3.fromRGB(80,220,80)
        elseif dist < 150 then
            distLbl.TextColor3 = Color3.fromRGB(220,180,60)
        else
            distLbl.TextColor3 = Color3.fromRGB(180,100,100)
        end
        distLbl.TextSize = 11
        distLbl.Font = Enum.Font.Gotham
        distLbl.TextXAlignment = Enum.TextXAlignment.Right
        distLbl.ZIndex = 2
        distLbl.Parent = row

        -- Hover highlight
        clickBtn.MouseEnter:Connect(function()
            row.BackgroundColor3 = isIgnored(cap)
                and Color3.fromRGB(160,45,45)
                or  Color3.fromRGB(55,55,80)
        end)
        clickBtn.MouseLeave:Connect(function()
            row.BackgroundColor3 = isIgnored(cap)
                and Color3.fromRGB(110,25,25)
                or  Color3.fromRGB(32,32,52)
        end)

        -- Toggle ignore on click
        clickBtn.MouseButton1Down:Connect(function()
            if IGNORE[cap] then IGNORE[cap] = nil else IGNORE[cap] = true end
            pcall(refreshIgnorePanel)
        end)

        y = y + ROW
    end

    -- Scroll arrow visibility
    if GUI.igUp then
        GUI.igUp.BackgroundColor3 = ST.igScroll > 0
            and Color3.fromRGB(60,40,90)
            or  Color3.fromRGB(25,22,35)
        GUI.igUp.TextColor3 = ST.igScroll > 0
            and Color3.fromRGB(220,180,255)
            or  Color3.fromRGB(70,60,90)
    end
    if GUI.igDown then
        GUI.igDown.BackgroundColor3 = ST.igScroll < MAX
            and Color3.fromRGB(60,40,90)
            or  Color3.fromRGB(25,22,35)
        GUI.igDown.TextColor3 = ST.igScroll < MAX
            and Color3.fromRGB(220,180,255)
            or  Color3.fromRGB(70,60,90)
    end
end

