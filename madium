        -- ESP update (throttled ~5-10 hz)
        local nowT = os.clock()
        if nowT - ST.espT > 0.1 + RNG:NextNumber(0,0.1) then
            ST.espT = nowT
            if ST.stealth and nowT - ST.killT > 20 then ST.stealth = false end
            pcall(function()
                local charsChanged = false
                local changedChars = {}
                local rngL = (ST.stealth and S.AC.cl) and S.ES.sd or S.ES.md
                for _, pl in ipairs(Players:GetPlayers()) do
                    if pl ~= ME then
                        local c    = pl.Character
                        local prev = CHARS[pl]
                        if prev ~= c then
                            if prev then
                                PART_CACHE[prev] = nil
                                changedChars[#changedChars+1] = prev
                            end
                            CHARS[pl] = c; charsChanged = true
                        end
                        if not S.ES.on then
                            if IESP[pl] then destroyInstanceESP(pl) end
                        else
                            if c and al(c) then
                                local cam = CAM()
                                local rt  = fr(c)
                                if cam and rt and
                                (cam.CFrame.Position-rt.Position).Magnitude <= rngL then
                                    local esp = IESP[pl]
                                    if esp == nil then
                                        createInstanceESP(pl)
                                    elseif esp.fail then
                                        if nowT - esp.fail > 2 then createInstanceESP(pl) end
                                    elseif esp.highlight then
                                        if esp.highlight.Parent==nil or esp.billboard.Parent==nil then
                                            IESP[pl] = nil
                                            local k = nowT
                                            if k-ST.killT < 8 then ST.kills=ST.kills+1 else ST.kills=1 end
                                            ST.killT = k
                                            if ST.kills >= 3 then ST.stealth=true; ST.kills=0 end
                                            createInstanceESP(pl)
                                        else
                                            esp.highlight.FillColor = isEnemy(pl) and S.ES.ce or S.ES.ct
                                            if esp.txt2 then
                                                local hum = c:FindFirstChildOfClass("Humanoid")
                                                local dd  = safeFloor((cam.CFrame.Position-rt.Position).Magnitude,0)
                                                local hp  = "?"
                                                if hum then
                                                    local hv = hum.Health
                                                    if hv==hv and hv>=0 then hp=tostring(safeFloor(hv,0)) end
                                                end
                                                esp.txt2.Text = hp.." HP | "..dd.."m"
                                                esp.txt2.TextColor3 = hpColor(hum)
                                            end
                                            if S.AC.nm and nowT-esp.ren > S.AC.rg then renameESP(pl) end
                                        end
                                    end
                                else
                                    if IESP[pl] then destroyInstanceESP(pl) end
                                end
                            else
                                if IESP[pl] then destroyInstanceESP(pl) end
                            end
                        end
                    end
                end
                if charsChanged then
                    for i = 1, #changedChars do clearLOSCForChar(changedChars[i]) end
                end
            end)
        end

        pcall(doAimbot, dt)
        pcall(sa)
        pcall(tb)
    end)
end)

