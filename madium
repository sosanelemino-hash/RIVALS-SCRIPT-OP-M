-- ============================================================
-- AIMBOT
-- [FIX-A] Uses hysteresis-aware findTarget()
-- [FIX-C] Smooth transition on target switch (0.15s ramp)
-- [FIX-D] Jitter scales with distance (no deflection at close range)
-- ============================================================
local function doAimbot(dt)
    if not S.AM.on then ST.tg=nil; ST.tgpl=nil; ST.tgDist=999; return end

    local p, pl = findTarget(S.FV.r, S.AM.md, S.AM.tc, S.AM.wc, false)
    if not p then ST.tg=nil; ST.tgpl=nil; ST.tgDist=999; return end

    -- [FIX-A/C] Detect target switch and record timestamp
    local prevPl = ST.tgpl
    if prevPl ~= pl then
        ST.switchT = os.clock()
        ST.lkT     = os.clock() + (S.AC.hz and RNG:NextNumber(0.05, S.AM.lo+0.1) or 0)
    end
    ST.tg = p; ST.tgpl = pl

    local ramping    = ST.lkT > os.clock()
    -- [FIX-C] During 0.15s after a switch, use reduced smoothing
    local switching  = (os.clock() - ST.switchT) < 0.15
    local pos        = (S.AM.pd > 0) and pp(p, pl) or p.Position
    local cam        = CAM(); if not cam then return end

    if not haveMouse() then
        local lk     = CFrame.lookAt(cam.CFrame.Position, pos)
        local sp, on = cam:WorldToViewportPoint(pos)
        local d      = on and (Vector2.new(sp.X,sp.Y)
            - Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)).Magnitude or 400
        local dNorm     = cl(d/350, 0, 1)
        local smoothEff = math.max(0.08, S.AM.sm * (1 - dNorm*0.6))
        if ramping   then smoothEff = smoothEff * 0.55 end
        if switching then smoothEff = smoothEff * 0.4  end  -- [FIX-C]
        local al2 = 1 - math.pow(1 - smoothEff, (dt or 0.016)*60)
        if ramping then
            lk = lk * CFrame.new(RNG:NextNumber(-0.7,0.7), RNG:NextNumber(-0.7,0.7), 0)
        end
        cam.CFrame = cam.CFrame:Lerp(lk, cl(al2, 0, 0.6))
        return
    end

    local sp, on = cam:WorldToViewportPoint(pos)
    if not on then return end
    local cx, cy = cam.ViewportSize.X/2, cam.ViewportSize.Y/2
    local dx, dy = sp.X-cx, sp.Y-cy
    local d      = math.sqrt(dx*dx + dy*dy)
    if d < 4 then return end

    local dNorm     = cl(d/350, 0, 1)
    local smoothEff = math.max(0.08, S.AM.sm * (1 - dNorm*0.6))
    if ramping   then smoothEff = smoothEff * 0.55 end
    if switching then smoothEff = smoothEff * 0.4  end  -- [FIX-C]

    local f  = 1 - smoothEff
    local mx = dx * f
    local my = dy * f

    -- [FIX-D] Jitter scales with distance so close shots stay on target
    if ramping then
        local jitterScale = cl(d / 100, 0.05, 1.0)
        mx = mx + RNG:NextNumber(-0.7,0.7) * jitterScale
        my = my + RNG:NextNumber(-0.7,0.7) * jitterScale
    end

    local mm = 14 + dNorm*34
    if math.abs(mx) > mm then mx = sg(dx)*mm end
    if math.abs(my) > mm then my = sg(dy)*mm end

    if RNG:NextNumber() < 0.04 then return end

    if CAP.mr then
        pcall(mousemoverel, mx, my)
    else
        local gx, gy = UI:GetMouseLocation().X, UI:GetMouseLocation().Y
        pcall(mousemoveabs, gx+mx, gy+my)
    end
end

