            pcall(function()
                local charsChanged = false
                local rngL = (ST.stealth and S.AC.cl) and S.ES.sd or S.ES.md
                local allPlayers = Players:GetPlayers()
                for i = 1, #allPlayers do
                    local pl = allPlayers[i]
                    if pl ~= ME then
                        local c = pl.Character
                        local prev = CHARS[pl]
                        if prev ~= c then
