local okIn, errIn = pcall(function()
    hook(UI.InputBegan:Connect(function(inp, gpd)
        if UI:GetFocusedTextBox() then return end

        -- Rebind capture mode
        if ST._rb then
            if isM(inp) then
                if inp.UserInputType == Enum.UserInputType.MouseButton2 then
                    S.KB[ST._rb.key] = "MouseButton2"
                    ST._rb.btn.Text = "MouseButton2"
                    ST._rb.btn.TextColor3 = Color3.fromRGB(0, 200, 255)
                    ST._rb = nil
                end
                return
            end
            -- F5 and F7 cannot be rebound
            if inp.KeyCode == Enum.KeyCode.F5 or inp.KeyCode == Enum.KeyCode.F7 then
                ST._rb.btn.Text = ST._rb.old
                ST._rb.btn.TextColor3 = Color3.fromRGB(0, 200, 255)
                ST._rb = nil
                return
            end
            if inp.KeyCode == Enum.KeyCode.Escape then
                ST._rb.btn.Text = ST._rb.old
                ST._rb.btn.TextColor3 = Color3.fromRGB(0, 200, 255)
                ST._rb = nil
                return
            end
            local nn = nil
            if inp.KeyCode ~= Enum.KeyCode.Unknown then
                nn = EN[inp.KeyCode] or tostring(inp.KeyCode):gsub("Enum.KeyCode.","")
            elseif inp.UserInputType ~= Enum.UserInputType.None then
                nn = EN[inp.UserInputType] or tostring(inp.UserInputType):gsub("Enum.UserInputType.","")
            end
            if nn then
                S.KB[ST._rb.key] = nn
                ST._rb.btn.Text = nn
                ST._rb.btn.TextColor3 = Color3.fromRGB(0, 200, 255)
                ST._rb = nil
            end
            return
        end

        -- RMB arm
        if inp.UserInputType == Enum.UserInputType.MouseButton2 then
            ST.arm = true
            if holdToAimEnabled then S.AM.on = true end
        end

        -- F7: panic hide/show menu + wipe ESP when hiding
        if inp.KeyCode == Enum.KeyCode.F7 then
            if GUI.main then
                local nv = not GUI.main.Visible
                setMenuVisible(nv)
                if not nv and S.AC.hi then destroyAllInstanceESP() end
            end
            return  -- stop here, do NOT fall through to feature keys
        end

        -- F5: KEYS panel toggle (hardcoded, dedicated)
        if inp.KeyCode == Enum.KeyCode.F5 then
            toggleKeysPanel()
            return
        end

        -- Feature keys (all rebindable)
        local function updateButton(name, state, onColor, offColor)
            local children = GUI.main and GUI.main:GetChildren() or {}
            for i = 1, #children do
                local v = children[i]
                if v:IsA("TextButton") and v.Text:sub(1, #name + 1) == name .. ":" then
                    v.Text = name .. ": " .. (state and "ON" or "OFF")
                    v.BackgroundColor3 = state and onColor or offColor
                end
            end
        end

        if mk(inp, "am") then
            S.AM.on = not S.AM.on
            if not S.AM.on then ST.tg = nil; ST.tgpl = nil end
            updateButton("AIMBOT", S.AM.on, Color3.fromRGB(60,255,60), Color3.fromRGB(255,60,60))
        end
        if mk(inp, "es") then
            S.ES.on = not S.ES.on
            if not S.ES.on then destroyAllInstanceESP() end
            updateButton("ESP", S.ES.on, Color3.fromRGB(60,255,60), Color3.fromRGB(255,60,60))
        end
        if mk(inp, "sl") then
            S.SL.on = not S.SL.on
            updateButton("SILENT", S.SL.on, Color3.fromRGB(60,255,60), Color3.fromRGB(255,140,0))
        end
        if mk(inp, "tr") then
            S.TR.on = not S.TR.on
            updateButton("TRIGGER", S.TR.on, Color3.fromRGB(60,255,60), Color3.fromRGB(255,60,60))
        end
        if mk(inp, "wc") then
            local nv = not S.AM.wc; S.AM.wc = nv; S.SL.wc = nv; S.TR.wc = nv
            updateButton("WALL", nv, Color3.fromRGB(60,255,60), Color3.fromRGB(255,140,0))
        end

        if gpd then return end
    end))

    hook(UI.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton2 then
            ST.arm = false
            if holdToAimEnabled then S.AM.on = false end
        end
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            SI.dragging = false
        end
    end))
end)
if not okIn then warn("[OPSYX] Input init failed: " .. tostring(errIn)) end

