            ST.arm   = false
            ST.saArm = false
            if holdToAimEnabled then S.AM.on = false end
        end
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            tsp(function() tw(0.05); ST.saArm = false end)
            SI.dragging = false
        end
    end))
